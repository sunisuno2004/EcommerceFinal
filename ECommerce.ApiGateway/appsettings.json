{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },

      "products-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Products/{**catch-all}"
        }
      },

      "batches-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/ProductBatches/{**catch-all}"
        }
      },

      "inventory-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Inventory/{**catch-all}"
        }
      },

      "cart-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/Cart/{**catch-all}"
        }
      },

      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/Orders/{**catch-all}"
        }
      },

      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/Payments/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product-destination": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://127.0.0.1:5103/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://127.0.0.1:5104/"
          }
        }
      }
    }
  }
}